<%= form_with(model: room) do |form| %>
  <% if room.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(room.errors.count, "error") %> prohibited this room from being saved:</h2>

      <ul>
        <% room.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :floor, style: "display: block" %>
    <%= form.number_field :floor %>
  </div>

  <div>
    <%= form.label :capacity, style: "display: block" %>
    <%= form.number_field :capacity %>
  </div>

  <div>
    <%= form.label :building_id, style: "display: block" %>
    <%= form.collection_select :building_id, Building.all, :id, :name %>
  </div>

  <div class="room_type_select">
    <%= form.label :room_type_id, style: "display: block" %>
    <% RoomType.all.each do |row| %>
        <br><%= form.radio_button :room_type_id, row.id%>
        <%= row.name %>
      <% end %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
