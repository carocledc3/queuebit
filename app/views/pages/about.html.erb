<%= render template: 'layouts/outside' %>

<div class="w-5xl flex flex-col justify-center items-center mx-auto gap-2">
    <span id="page-top"></span>
    
    <div class="home-container flex flex-col my-16 gap-4">
        <div class="home-content">
            <h1 class="title">About Queuebit</h1>
