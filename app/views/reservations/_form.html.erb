
<%= form_with(model: reservation) do |form| %>

  <% if reservation.errors.any? %>
    <div style="color: red">
        <% reservation.errors.each do |error| %>
          <p><%= error.message %></p>
        <% end %>
    </div>
  <% end %>
<div class="testform">
  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :reservation_date, style: "display: block" %>
    <%= form.date_field :reservation_date %>
  </div>

  <div>
    <%= form.label :reservation_start, style: "display: block" %>
    <%= form.time_field :reservation_start %>
  </div>

  <div>
    <%= form.label :reservation_end, style: "display: block" %>
    <%= form.time_field :reservation_end %>
  </div>

  <div>
    <%= form.label :room_id, style: "display: block" %>
    <%= form.collection_select :room_id, Room.where.not(room_type_id: 16).or(Room.where.not(room_type_id: 15)), :id, :name %>
  </div>

  <div>
    <%= form.label :event_id, style: "display: block" %>
    <%= form.collection_select :event_id, Event.all, :id, :name %>
  </div>

  
  </div>
  
  <div>
    <%= form.submit %>
  </div>
<% end %>
