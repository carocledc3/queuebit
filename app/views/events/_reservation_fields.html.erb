<%= cocooned_item do %>
<div class="testform">
      <div>
        <%= f.label :name, style: "display: block" %>
        <%= f.text_field :name %>
      </div>

      <div>
        <%= f.label :reservation_start, style: "display: block" %>
        <%= f.datetime_field :reservation_start %>
      </div>

      <div>
        <%= f.label :reservation_end, style: "display: block" %>
        <%= f.datetime_field :reservation_end %>
      </div>

      <div>
        <%= f.label :room_id, style: "display: block" %>
        <%= f.collection_select :room_id, Room.where.not(room_type_id: 16).or(Room.where.not(room_type_id: 15)), :id, :name %>
      </div>

      <button type="button" data-action="nested-form#remove">Remove reservation</button>
      <%= f.hidden_field :_destroy %>

</div>
<% end %>