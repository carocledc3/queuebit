<div id="<%= dom_id event %>">
  <div>
    <strong>Name:</strong>
    <%= event.name %>
  </div>

  <div>
    <strong>Start date:</strong>
    <%= event.start_date %>
  </div>

  <div>
    <strong>End date:</strong>
    <%= event.end_date %>
  </div>

  <div>
    <strong>Organisation:</strong>
    <%= link_to event.organisation.abbreviation, organisations_path(event.organisation_id) %>
  </div>

  <div>
    <strong>Employee:</strong>
    <%= link_to event.employee.name, employees_path(event.employee_id) %>
  </div>

  <div>
    <strong>Details:</strong>
    <%= event.details %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= event.description %>
  </div>

  <div>
    <% unless event.reservations.nil? %>
      <strong>Reservations:</strong>
      <ul>
        <% event.reservations.each do |resv| %>
          <li><%= resv.room.name %> from <%= resv.reservation_start %></li>
        <% end %>
      </ul>
    
    <% end %>
    
  </div>

</div>
