<div id="<%= dom_id employee %>">

  <h2><%= employee.name %></h2>
  <div>
    <strong>ID:</strong>
    <%= employee.id %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= employee.name %>
  </div>

  <div>
    <strong>Designation:</strong>
    <%= employee.designation %>
  </div>

  <div>
    <strong>Contact:</strong>
    <%= employee.contact %>
  </div>

  <div>
    <strong>Department:</strong>
    <%= link_to employee.department.name, department_path(employee.department_id) %>
  </div>

</div>
